+    /// Load already quantized MLX Diffusers-style weights, never materializing BF16
+    /// transformer weights. Validation is fail-closed: a missing or mismatched
+    /// quantized parameter is an error, not permission to render random weights.
+    static func loadKlein9BInt4Weights(from directory: URL, into model: Flux2Transformer2DModel) throws {
+        guard Klein9BMLXInt4Model.isAvailable else {
+            throw Flux2Error.modelNotLoaded("Missing MLX Klein 9B Int4 transformer. Download it in the Models tab.")
+        }
+        // A safetensors header can be valid even when the binary was cut short.
+        let index = directory.appendingPathComponent("model.safetensors.index.json")
+        let data = try Data(contentsOf: index)
+        guard let object = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let weights = object["weight_map"] as? [String: String] else {
+            throw Flux2Error.modelNotLoaded("Invalid MLX 9B Int4 shard index.")
+        }
+        for name in Set(weights.values) {
+            let url = directory.appendingPathComponent(name)
+            guard Flux2PrequantizedCheckpoint.payloadIsComplete(url: url) else {
+                throw Flux2Error.modelNotLoaded("Incomplete MLX 9B Int4 shard: \(name)")
+            }
+        }
+
+        var raw = try loadWeights(from: directory)
+        let mapped = mapTransformerWeights(&raw)
+        raw.removeAll()
+
+        // Native MLX QuantizedLinear parameter names match the model's camelCase
+        // layout; mapTransformerWeights translates Diffusers names and preserves
+        // .weight/.scales/.biases, without dequantizing the 4-bit payload.
+        let castParameters = Dictionary(uniqueKeysWithValues:
+            model.parameters().flattened().map { ($0.0, $0.1.asType(.float16)) })
+        _ = model.update(parameters: ModuleParameters.unflattened(castParameters))
+        quantize(model: model, groupSize: 64, bits: 4, mode: .affine)
+        let expected = Dictionary(uniqueKeysWithValues: Array(model.parameters().flattened()))
+        let missing = Set(expected.keys).subtracting(mapped.keys)
+        let extra = Set(mapped.keys).subtracting(expected.keys)
+        guard missing.isEmpty && extra.isEmpty else {
+            throw Flux2Error.modelNotLoaded("MLX 9B Int4 tensor mapping mismatch (missing \(missing.count), extra \(extra.count)).")
+        }
+
+        let floating: Set<DType> = [.float16, .bfloat16, .float32]
+        for (name, target) in expected {
+            guard let source = mapped[name] else { continue }
+            let dtypeOK = source.dtype == target.dtype ||
+                (floating.contains(source.dtype) && floating.contains(target.dtype))
+            guard source.shape == target.shape && dtypeOK else {
+                throw Flux2Error.modelNotLoaded("MLX 9B Int4 incompatible tensor: \(name).")
+            }
+        }
+
+        _ = try model.update(parameters: ModuleParameters.unflattened(mapped), verify: .shapeMismatch)
+        eval(model.parameters())
+    }
+
