# Swift Package Manager / build artifacts
.build*/
.swiftpm/
Package.resolved.bak
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# macOS
.DS_Store

# Models & generated content are NOT stored in the repo.
# They live under ~/Library/Application Support/Typhoonminigen/ at runtime.
/Models/
/Images/
*.safetensors
*.gguf
*.mlmodelc
*.png

# Defence in depth: user-data files only ever live under ~/Library at runtime, but block them
# by name too so a stray copy (e.g. dragged into the repo) can never be committed.
generations*.json
*.log
custom-presets*.json

# README screenshots ARE tracked (the *.png rule above is for generated images).
# ** so screenshots in any docs/ subfolder (docs/screenshots/…) are kept too.
!docs/**/*.png

# Editor / assistant tooling
.vscode/
*.swp
# Local tooling session data, memory, history & config — local only, never commit.
.claude/
CLAUDE.md
PROJECT_MEMORY*
/memory/

# Internal audits / plans / analysis notes — never publish.
*audit*.md
*AUDIT*.md
*audit*.json
*AUDIT*.json
PLAN-*.md

# Certificates, keys, secrets — defence in depth (should never exist here, but never commit).
*.p12
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*
*.key
id_rsa
id_dsa
id_ed25519

# Databases
*.sqlite
*.sqlite3
*.db

# Built app bundles / archives (regenerated by the build)
*.app
*.dmg
*.zip
*.ipa
*.xcarchive
*.dSYM/

# Icon source assets in tools/ ARE tracked (the *.png rule above is for generated images)
!tools/*.png
*.profraw
